# ── 영화 메타 API ──
TMDB_API_KEY=
KOBIS_API_KEY=
OMDB_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 영화소식 자동수집 ──
# Railway Postgres 연결 문자열 (Railway 대시보드에서 Postgres 추가 시 자동 주입)
DATABASE_URL=
# GitHub Actions cron 인증용 시크릿 (임의의 긴 문자열, GH 저장소 시크릿과 동일하게)
CRON_SECRET=

# ── Google Sheets DB ──
# 서비스 계정 JSON 전체를 한 줄 문자열로 (개행 \n 이스케이프)
GOOGLE_CREDENTIALS_JSON=
# 시트 ID 직접 지정(우선) 또는 이름으로 Drive 검색
GOOGLE_SPREADSHEET_ID=
GOOGLE_SPREADSHEET_NAME=MK_CINELAB_DB
